# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# SSH / SFTP connection (All-inkl / kasserver.com), same host as the other tools.
SSH_HOST=w0077762.kasserver.com
SSH_USER=ssh-w0077762
SSH_PORT=22

# Private key for key-based auth (same key the main site / other tools use).
SSH_KEY="$HOME/.ssh/felixschaller_deploy"

# Target folder on the server, relative to the SSH home (no leading/trailing
# slash). public.felixschaller.com maps to www/htdocs/w0077762/public, so this
# demo gets its own folder under public/tools/.
REMOTE_PATH=www/htdocs/w0077762/public/tools/hierarchical-perception

# Public base URL, used only to print the final link.
SITE_URL=https://public.felixschaller.com
